{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ghost Process: Dry-Run (Test RSS Feeds Only)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--mode", "recon", "--dry-run"],
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Ghost Process: Job 1 - Recon & Emergency Flow",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--mode", "recon"],
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Ghost Process: Job 2 - Daily Digest",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/digest.py",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
